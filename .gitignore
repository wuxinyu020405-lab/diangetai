# 凭据与本地配置 —— 含真实 cookie / musickey，绝不进版本库
config.json
credential.json

# 音频缓存与下载产物
music_cache/

# Python 虚拟环境（180MB，可由 requirements.txt 重建）
.venv/

# 字节码与工具产物
__pycache__/
*.py[cod]
.pip-cache/
_dl/

# 打包产物（.spec 不排除：它含 hiddenimports 等关键配置，应纳入版本管理）
build/
dist/
*.exe

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
debug.log

# 配额记账（运行时产物，跨重启本地有效）
quota_state.json

# 登录浏览器临时区（程序目录内，运行时产物）
_login_profile/
_login_tmp/
*.part
_chk.js

# 运行日志与界面备份（本地文件，不入库）
_run_gui.log
*.bak_ui
*.bak_before_2line

# UI 改动前备份
*.bak_before_revert
