config.json
credential.json

# 音频缓存与下载产物
music_cache/

# Python 虚拟环境（180MB，可由 requirements.txt 重建）
.venv/

# 字节码与工具产物
__pycache__/
*.py[cod]
.pip-cache/
_dl/

# 打包产物（.spec 不排除：它含 hiddenimports 等关键配置，应纳入版本管理）
build/
dist/
*.exe

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
debug.log
